<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
<carrier_config_list>
<carrier_config>
    <!-- 中国联通 China Unicom（46001）
         AOSP 里没有任何中国大陆 MCCMNC 的运营商配置，导致
         carrier_volte_available_bool 取默认值 false，框架就完全不会去注册 IMS。
         本文件把它打开；IMS APN(apn=ims) 在 apns-conf.xml 里本来就有。 -->
    <boolean name="carrier_volte_available_bool" value="true" />
    <boolean name="carrier_volte_provisioning_required_bool" value="false" />
    <boolean name="carrier_volte_provisioned_bool" value="true" />
    <boolean name="enhanced_4g_lte_on_by_default_bool" value="true" />
    <boolean name="hide_enhanced_4g_lte_bool" value="false" />
    <boolean name="carrier_use_ims_first_for_emergency_bool" value="true" />
    <boolean name="carrier_allow_turnoff_ims_bool" value="true" />
    <boolean name="carrier_wfc_ims_available_bool" value="false" />
    <int name="carrier_default_wfc_ims_mode_int" value="2" />
    <boolean name="hide_ims_apn_bool" value="false" />
    <!-- 通话录音：Dialer 侧 call_recording_enabled 本来就是 true，
         这里只关掉录音提示音（CarrierConfigManager.KEY_PLAY_CALL_RECORDING_TONE_BOOL） -->
    <boolean name="play_call_recording_tone_bool" value="false" />
</carrier_config>
</carrier_config_list>
